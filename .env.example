# PostgreSQL container credentials (used by Docker Compose)
POSTGRES_DB=synthetic_user_lab
POSTGRES_USER=sul
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432

# Host-run Flask app (Docker Compose overrides this with the db service host).
# Percent-encode reserved URL characters in the password.
DATABASE_URL=postgresql://sul:replace-with-a-strong-password@localhost:5432/synthetic_user_lab

# Application
SECRET_KEY=replace-with-a-long-random-secret
LOG_LEVEL=INFO
WEB_MAX_BATCH_SIZE=100
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000

# Gunicorn (Docker image)
WEB_CONCURRENCY=2
GUNICORN_THREADS=4

# Docker Compose port mapping
APP_PORT=8000
